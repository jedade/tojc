---
/**
 * Carrousel d'accueil — fondu enchaîné + léger zoom, en CSS pur.
 * Le script (motion.ts) ajoute seulement le bouton pause et les puces cliquables.
 */
import { Image } from 'astro:assets';
import { SLIDES } from '../photos';

const DURATION = 6; // secondes par image
// Classes de position (pas d'attribut style inline : CSP stricte)
const posClass = (p: string) => 'pos-' + p.replace(/[^0-9]+/g, '-').replace(/^-|-$/g, '');
---

<div
  class="slider unveil"
  data-slider
  data-duration={DURATION}
  role="region"
  aria-roledescription="carrousel"
  aria-label="Images ToJC"
>
  {SLIDES.map((s, i) => (
    <figure class:list={['slide', `s${i}`]} aria-hidden={i === 0 ? undefined : 'true'}>
      <Image
        src={s.src}
        alt={s.alt}
        class={posClass(s.position)}
        widths={[480, 800, 1140, 1400]}
        sizes="(min-width: 1024px) 700px, 100vw"
        loading={i < 2 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : undefined}
      />
    </figure>
  ))}

  <div class="controls">
    <div class="dots">
      {SLIDES.map((s, i) => (
        <button type="button" class:list={['dot', `s${i}`]} data-slide-to={i} aria-label={`Image ${i + 1} sur ${SLIDES.length}`}>
          <span></span>
        </button>
      ))}
    </div>
    <button type="button" class="pause" data-slider-pause aria-pressed="false" aria-label="Mettre le carrousel en pause">
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l12 7-12 7z" /></svg>
    </button>
  </div>
  <span class="tag" aria-hidden="true"></span>
</div>

<style>
  .slider {
    --total: 30s;
    position: relative;
    aspect-ratio: 21 / 10;
    background: var(--navy-dark);
    overflow: hidden;
  }
  .slide { position: absolute; inset: 0; margin: 0; overflow: hidden; }
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .slide :global(.pos-50-30) { object-position: 50% 30%; }
  .slide :global(.pos-70-50) { object-position: 70% 50%; }
  .slide :global(.pos-50-60) { object-position: 50% 60%; }
  .slide :global(.pos-50-50) { object-position: 50% 50%; }

  /* Fondu enchaîné : chaque image occupe 1/5 du cycle */
  .slide { opacity: 0; animation: slide-fade var(--total) infinite both; }
  .slide :global(img) { animation: slide-zoom var(--total) infinite both; }
  .slide.s1, .s1 :global(img) { animation-delay: 6s; }
  .slide.s2, .s2 :global(img) { animation-delay: 12s; }
  .slide.s3, .s3 :global(img) { animation-delay: 18s; }
  .slide.s4, .s4 :global(img) { animation-delay: 24s; }
  /* La 1re image est visible d'emblée (pas d'écran vide au chargement) */
  .s0 { opacity: 1; }

  @keyframes slide-fade {
    0% { opacity: 0; }
    4% { opacity: 1; }
    20% { opacity: 1; }
    25% { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes slide-zoom {
    0% { transform: scale(1.1); }
    25% { transform: scale(1); }
    100% { transform: scale(1); }
  }

  /* Pause au survol, au focus clavier ou via le bouton */
  .slider:hover .slide, .slider:hover .slide :global(img), .slider:hover .dot span,
  .slider:focus-within .slide, .slider:focus-within .slide :global(img), .slider:focus-within .dot span,
  .slider.is-paused .slide, .slider.is-paused .slide :global(img), .slider.is-paused .dot span {
    animation-play-state: paused;
  }

  /* ---------- Commandes ---------- */
  .controls {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 4px 4px 10px;
    background: rgb(18 29 77 / 0.72);
    backdrop-filter: blur(6px);
  }
  .dots { display: flex; gap: 6px; }
  .dot {
    width: 28px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    align-items: center;
  }
  .dot::before {
    content: '';
    grid-area: 1 / 1;
    height: 3px;
    background: rgb(255 255 255 / 0.35);
  }
  .dot span {
    grid-area: 1 / 1;
    height: 3px;
    background: var(--white);
    transform-origin: left;
    transform: scaleX(0);
    animation: dot-fill var(--total) linear infinite both;
  }
  .dot.s1 span { animation-delay: 6s; }
  .dot.s2 span { animation-delay: 12s; }
  .dot.s3 span { animation-delay: 18s; }
  .dot.s4 span { animation-delay: 24s; }
  @keyframes dot-fill {
    0% { transform: scaleX(0); }
    20% { transform: scaleX(1); }
    20.01%, 100% { transform: scaleX(0); }
  }
  .pause {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border: 0;
    background: none;
    color: var(--white);
    cursor: pointer;
  }
  .pause svg { width: 16px; height: 16px; fill: currentColor; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; }
  .pause .i-pause { fill: none; }
  .i-play { display: none; }
  .slider.is-paused .i-pause { display: none; }
  .slider.is-paused .i-play { display: block; }

  .tag {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 96px;
    height: 6px;
    background: var(--red);
    transform-origin: left;
    animation: grow-x 0.8s var(--ease-out) 1.2s both;
  }

  @media (max-width: 700px) { .slider { aspect-ratio: 16 / 10; } }

  /* Mouvement réduit : image fixe, pas de défilement automatique */
  @media (prefers-reduced-motion: reduce) {
    .slide, .slide :global(img), .dot span { animation: none !important; }
    .slide { opacity: 0; }
    .s0 { opacity: 1; }
    .dots { display: none; }
    .pause { display: none; }
    .controls { display: none; }
  }
</style>
