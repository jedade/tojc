---
import { u } from '../site';
import { Image } from 'astro:assets';
import logo from '../assets/logo-tojc.png';
import { SITE, EXPERTISES } from '../site';
const year = new Date().getFullYear();
const c = SITE.contact;
---

<footer class="footer">
  <div class="wrap inner">
    <div class="intro" data-reveal>
      <a class="brand" href={u("/")}>
        <Image src={logo} alt="ToJC" width={150} />
        <span>Towards Just<br />Consultancy FZ-LLC</span>
      </a>
      <p>
        ToJC accompagne entreprises et investisseurs en conseil stratégique et finance, commerce
        international, transport et logistique, et bâtiment et travaux publics.
      </p>
    </div>

    <div class="cols" data-line data-stagger="80">
      <div class="col" data-reveal>
        <span class="col-title">Le cabinet</span>
        <a href={u("/qui-sommes-nous")}>Qui sommes-nous</a>
        <a href={u("/expertises")}>Nos expertises</a>
        <a href={u("/contact")}>Contact</a>
      </div>
      <div class="col" data-reveal>
        <span class="col-title">Expertises</span>
        {EXPERTISES.map((e) => <a href={u(`/expertises#${e.id}`)}>{e.title}</a>)}
      </div>
      <div class="col" data-reveal>
        <span class="col-title">Nous contacter</span>
        <span>{c.name}, {c.role}</span>
        <a href={c.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp : {c.phoneDisplay}</a>
        {c.address && <span class="muted">{c.address}</span>}
        {c.email && <a href={`mailto:${c.email}`}>{c.email}</a>}
      </div>
    </div>

    <div class="legal">
      <span class="legal-links">
        <a href={u("/mentions-legales")}>Mentions légales</a>
        <a href={u("/mentions-legales#donnees")}>Données personnelles</a>
      </span>
      <span>© {year} {SITE.name}</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--white); border-top: 2px solid var(--navy); }
  .inner { padding-top: 40px; display: flex; flex-direction: column; gap: 32px; }
  .intro { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px 48px; }
  .brand { display: flex; align-items: center; gap: 16px; text-decoration: none; color: var(--ink); font-weight: 700; font-size: 16px; line-height: 1.3; }
  .brand img { height: 64px; width: auto; }
  .intro p { flex: 1 1 420px; max-width: 600px; font-size: 14px; color: var(--text); }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.5;
  }
  .col { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .col-title { font-weight: 700; }
  .col a { color: var(--ink); text-underline-offset: 3px; transition: color 0.2s, text-underline-offset 0.25s; }
  .col a:hover { color: var(--navy); text-underline-offset: 5px; }
  .muted { color: var(--muted); }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 16px 0 24px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }
  .legal-links { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .legal a { color: var(--muted); }
  .legal a:hover { color: var(--navy); }
</style>
