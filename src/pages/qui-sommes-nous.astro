---
import { u } from '../site';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE, PILLARS } from '../site';
import { PHOTOS } from '../photos';
const c = SITE.contact;
---

<Base title="Qui sommes-nous" active="apropos" description="Towards Just Consultancy (ToJC), cabinet de conseil et de réalisation : notre devise, notre direction, nos informations.">
  <div class="wrap crumbs">
    <a href={u("/")}>Accueil</a><span aria-hidden="true">›</span><span aria-current="page">Qui sommes-nous</span>
  </div>

  <section class="wrap hero">
    <div class="hero-copy">
      <h1 class="h1 enter enter-1">Qui sommes-nous</h1>
      <p class="lead enter enter-2">
        Towards Just Consultancy (ToJC) est un cabinet de conseil et de réalisation. Notre nom est le
        reflet de notre engagement envers l’intégrité et l’excellence opérationnelle.
      </p>
    </div>
    <div class="hero-media unveil">
      <Image src={PHOTOS.aPropos} alt="Tours de verre sous un ciel nuageux" widths={[500, 800]} sizes="(min-width: 1024px) 500px, 100vw" loading="eager" />
    </div>
  </section>

  <!-- LA DEVISE -->
  <section class="band">
    <div class="wrap block">
      <div class="head-col" data-reveal>
        <h2 class="h2">Notre devise&nbsp;: Toujours œuvrer en Juste Constructeur</h2>
        <p class="body">Les initiales ToJC désignent à la fois notre raison sociale et la devise qui guide chacune de nos missions.</p>
      </div>
      <div class="letters" data-stagger="140">
        {PILLARS.map((p, i) => (
          <div class="letter-card" data-reveal>
            <span class:list={['big', { red: i === 1 }]} aria-hidden="true">{p.letters}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DIRECTION + FICHE -->
  <section class="wrap duo">
    <div class="col" data-reveal="left">
      <h2 class="h2">Le mot du Directeur Général</h2>
      <blockquote>« Chez ToJC, nous ne nous contentons pas de conseiller&nbsp;; nous bâtissons. »</blockquote>
      <p class="sign"><strong>{c.name}</strong>, {c.role}</p>
    </div>
    <div class="col" data-reveal>
      <h2 class="h2">Informations</h2>
      <table class="info">
        <tbody>
          <tr><th scope="row">Raison sociale</th><td>{SITE.name}</td></tr>
          <tr><th scope="row">Forme</th><td>Société de zone franche, Émirats arabes unis{c.freeZone && ` — ${c.freeZone}`}</td></tr>
          <tr><th scope="row">Direction</th><td>{c.name}</td></tr>
          <tr><th scope="row">Domaines</th><td>Conseil et finance, commerce international, transport et logistique, BTP</td></tr>
          <tr><th scope="row">Contact</th><td><a href={u("/contact")}>WhatsApp {c.phoneDisplay}</a></td></tr>
        </tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 32px 64px; display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: center; }
  .hero-copy { flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .hero-media { flex: 1 1 400px; min-width: 0; height: 340px; }
  .hero-media img { width: 100%; height: 100%; object-fit: cover; }

  .band { background: var(--soft); }
  .block { padding-block: 64px; display: flex; flex-direction: column; gap: 32px; }
  .head-col { display: flex; flex-direction: column; gap: 8px; max-width: 760px; }

  .letters { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 24px; }
  .letter-card {
    background: var(--white);
    border: 1px solid var(--line);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out), opacity 0.8s var(--ease-out);
    transition-delay: var(--delay, 0s);
  }
  .letter-card:hover { transform: translateY(-4px); box-shadow: 0 16px 36px -18px rgb(27 42 107 / 0.3); }
  .big { font-size: 32px; font-weight: 700; color: var(--navy); line-height: 1; transition: transform 0.5s var(--ease-out); transform-origin: left bottom; }
  .big.red { color: var(--red); }
  .letter-card:hover .big { transform: scale(1.25); }
  .letter-card h3 { font-size: 18px; font-weight: 700; }
  .letter-card p { font-size: 15px; color: var(--text); }

  .duo { padding-block: 64px 80px; display: flex; flex-wrap: wrap; gap: 48px 64px; align-items: flex-start; }
  .col { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  blockquote { margin: 0; font-size: 20px; line-height: 1.6; padding-left: 20px; border-left: 3px solid var(--red); }
  .sign { font-size: 15px; color: var(--muted); }
  .sign strong { color: var(--ink); }
</style>
